{
  "$defs": {
    "FlagEvidence": {
      "description": "Unified risk flag containing concise, auditable evidence and source provenance.",
      "properties": {
        "name": {
          "description": "Risk indicator category identifier",
          "title": "Name",
          "type": "string"
        },
        "confidence": {
          "description": "Confidence score between 0.0 and 1.0",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "signals": {
          "description": "Concise explainable signal strings",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Signals",
          "type": "array"
        },
        "source": {
          "description": "Contributing modalities e.g. ['audio', 'text']",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source",
          "type": "array"
        }
      },
      "required": [
        "name",
        "confidence",
        "signals",
        "source"
      ],
      "title": "FlagEvidence",
      "type": "object"
    },
    "LanguageMetadata": {
      "description": "Language detection, capabilities, and validation status.",
      "properties": {
        "code": {
          "description": "ISO 639-1 language code (e.g. 'en', 'hi', 'mr', 'ta')",
          "title": "Code",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Language display name e.g. 'Marathi'",
          "title": "Name"
        },
        "confidence": {
          "default": 0.95,
          "description": "Language detection confidence score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "stt_status": {
          "default": "SUPPORTED",
          "description": "STT support status: 'SUPPORTED', 'TESTED', 'EXPERIMENTAL'",
          "title": "Stt Status",
          "type": "string"
        },
        "ser_status": {
          "default": "EXPERIMENTAL",
          "description": "SER support status: 'SUPPORTED' or 'EXPERIMENTAL'",
          "title": "Ser Status",
          "type": "string"
        },
        "text_status": {
          "default": "SUPPORTED",
          "description": "Text support status: 'SUPPORTED' or 'EXPERIMENTAL'",
          "title": "Text Status",
          "type": "string"
        },
        "tested_status": {
          "description": "Validation status: 'TESTED (Language)' or 'UNTESTED'",
          "title": "Tested Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "tested_status"
      ],
      "title": "LanguageMetadata",
      "type": "object"
    },
    "ModelMetadataMap": {
      "description": "Metadata detailing models used across perception layers.",
      "properties": {
        "stt_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "STT model name e.g. 'whisper-tiny'",
          "title": "Stt Model"
        },
        "ser_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SER model checkpoint e.g. 'wav2vec2-lg-xlsr'",
          "title": "Ser Model"
        },
        "text_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text model checkpoint e.g. 'google/muril-base-cased'",
          "title": "Text Model"
        },
        "execution_time_sec": {
          "description": "Total perception processing time in seconds",
          "minimum": 0.0,
          "title": "Execution Time Sec",
          "type": "number"
        }
      },
      "required": [
        "execution_time_sec"
      ],
      "title": "ModelMetadataMap",
      "type": "object"
    },
    "ModelPrediction": {
      "description": "Direct probability prediction from a perception model.",
      "properties": {
        "source": {
          "description": "Modality source: 'audio' or 'text'",
          "title": "Source",
          "type": "string"
        },
        "type": {
          "default": "model_prediction",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "description": "Target predicted label e.g. 'fear', 'intimidation'",
          "title": "Name",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "model_name": {
          "description": "Model identifier checkpoint name",
          "title": "Model Name",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name",
        "confidence",
        "model_name"
      ],
      "title": "ModelPrediction",
      "type": "object"
    },
    "RawMeasurement": {
      "description": "Grounded physical audio or text measurement.",
      "properties": {
        "source": {
          "description": "Modality source: 'audio' or 'text'",
          "title": "Source",
          "type": "string"
        },
        "type": {
          "description": "Measurement category e.g. 'acoustic_feature', 'text_pattern'",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "description": "Measurement identifier key e.g. 'pause_duration', 'pitch_std'",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "description": "Grounded numeric or string value",
          "title": "Value"
        },
        "unit": {
          "description": "Unit of measurement e.g. 'seconds', 'Hz', 'RMS', 'matches'",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "source",
        "type",
        "name",
        "value",
        "unit"
      ],
      "title": "RawMeasurement",
      "type": "object"
    },
    "SVIResult": {
      "description": "Stress Vulnerability Index (SVI) score and risk tier.",
      "properties": {
        "score": {
          "description": "Composite SVI score between 0 and 100",
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "risk_tier": {
          "description": "Risk tier: 'Low', 'Moderate', 'High', or 'Critical'",
          "title": "Risk Tier",
          "type": "string"
        }
      },
      "required": [
        "score",
        "risk_tier"
      ],
      "title": "SVIResult",
      "type": "object"
    },
    "SourcesMap": {
      "description": "Active perception data channels.",
      "properties": {
        "speech": {
          "description": "True if audio speech channel was processed",
          "title": "Speech",
          "type": "boolean"
        },
        "text": {
          "description": "True if text transcript/chat channel was processed",
          "title": "Text",
          "type": "boolean"
        }
      },
      "required": [
        "speech",
        "text"
      ],
      "title": "SourcesMap",
      "type": "object"
    }
  },
  "description": "Formal Versioned Output Contract for AI Perception Layer (v1.0).\nShared schema consumed directly by Aatmman's Decision Layer & Vinit's Case API.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Contract schema version",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Unique Central Case API Case ID",
      "title": "Case Id"
    },
    "timestamp": {
      "description": "Unix timestamp of perception execution",
      "title": "Timestamp",
      "type": "number"
    },
    "channel": {
      "default": "ivrs",
      "description": "Ingestion channel: 'ivrs', 'phone', 'chat', 'chatbot', 'portal', 'mobile_app'",
      "title": "Channel",
      "type": "string"
    },
    "language": {
      "allOf": [
        {
          "$ref": "#/$defs/LanguageMetadata"
        }
      ],
      "description": "Language code and testing status"
    },
    "svi": {
      "allOf": [
        {
          "$ref": "#/$defs/SVIResult"
        }
      ],
      "description": "Stress Vulnerability Index score and risk tier"
    },
    "stt_transcript": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Automatically transcribed speech-to-text transcript from audio",
      "title": "Stt Transcript"
    },
    "flags": {
      "description": "List of extracted risk flag evidence",
      "items": {
        "$ref": "#/$defs/FlagEvidence"
      },
      "title": "Flags",
      "type": "array"
    },
    "sources": {
      "allOf": [
        {
          "$ref": "#/$defs/SourcesMap"
        }
      ],
      "description": "Active source modalities processed"
    },
    "raw_measurements": {
      "description": "Grounded physical measurements",
      "items": {
        "$ref": "#/$defs/RawMeasurement"
      },
      "title": "Raw Measurements",
      "type": "array"
    },
    "model_predictions": {
      "description": "Direct neural model likelihoods",
      "items": {
        "$ref": "#/$defs/ModelPrediction"
      },
      "title": "Model Predictions",
      "type": "array"
    },
    "model_metadata": {
      "allOf": [
        {
          "$ref": "#/$defs/ModelMetadataMap"
        }
      ],
      "description": "Perception models metadata"
    },
    "safety_disclaimer": {
      "description": "Mandatory non-clinical disclaimer",
      "title": "Safety Disclaimer",
      "type": "string"
    }
  },
  "required": [
    "svi",
    "sources",
    "model_metadata",
    "safety_disclaimer"
  ],
  "title": "PerceptionOutputContract",
  "type": "object"
}