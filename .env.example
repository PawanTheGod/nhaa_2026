# ─── Supabase / PostgreSQL ─────────────────────────────────
# Replace with your Supabase project credentials — NEVER commit real passwords
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_API_KEY=
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_PORT=5432

# Use SQLite for quick local dev if DATABASE_URL is not set
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres

# ─── FastAPI Backend ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ─── JWT / Auth (Aditya will replace with real JWT) ───────
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Frontend API URL ─────────────────────────────────────
VITE_API_URL=http://localhost:8000
