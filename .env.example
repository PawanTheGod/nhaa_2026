# ─── Supabase / PostgreSQL ─────────────────────────────────
# Copy this file to backend/.env and fill in real credentials locally.
# Never commit .env. Do not put passwords in brain.md or chat logs.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_PORT=5432

# Use SQLite for quick local dev if DATABASE_URL is not set
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── FastAPI Backend ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ─── JWT / Auth (Aditya will replace with real JWT) ───────
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440